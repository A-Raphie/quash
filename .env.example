# Quash env. Copy to .env and fill in. Never commit .env.

# Photon Spectrum Cloud (app.photon.codes -> your project)
QUASH_PROJECT_ID=
QUASH_PROJECT_SECRET=

# Groq (console.groq.com). Any OpenAI-compatible endpoint works.
# Search runs gpt-oss-20b with Groq's built-in browser_search tool (fast tier);
# the verdict runs gpt-oss-120b.
QUASH_API_KEY=
QUASH_BASE_URL=https://api.groq.com/openai/v1
QUASH_MODEL=openai/gpt-oss-120b
QUASH_SEARCH_MODEL=openai/gpt-oss-20b

# Comma-separated E.164 allowlist (defense in depth; Photon enforces registered users upstream)
QUASH_ALLOWLIST=

# roast=on|off (default on), polls=on|off (default off)
QUASH_ROAST=on
QUASH_POLLS=off
